<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamePortal - Gestão e Consulta de Jogos</title>
    <link rel="stylesheet" href="/css/site/style.css">
</head>
<body>
    <div class="accessibility-bar" role="region" aria-label="Acessibilidade">
        <span>Acessibilidade:</span>
        <button id="btn-increase-font" aria-label="Aumentar fonte">A+</button>
        <button id="btn-decrease-font" aria-label="Diminuir fonte">A-</button>
        <button id="btn-reset-font" aria-label="Tamanho normal">A</button>
    </div>

    <%- include('cabecalho.ejs') %>

    <main>
        <h2 class="section-title">Catálogo de Jogos</h2>

        <div class="grid">
            <% if (jogos.length) { %>
                <% jogos.forEach((jogo) => { %>
                    <article class="card">
                        <a href="/site/jogo-detalhes/<%= jogo.id %>" aria-label="Ver detalhes de <%= jogo.titulo %>">
                            <% if (jogo.capa && jogo.capa.length > 0) { %>
                                <img src="/jogo/capa/<%= jogo.id %>" alt="Capa de <%= jogo.titulo %>" class="card-img">
                            <% } else { %>
                                <div class="card-img card-img-placeholder" role="img" aria-label="Capa não cadastrada">Capa não cadastrada</div>
                            <% } %>
                        </a>
                        <div class="card-body">
                            <% if (jogo.genero) { %><span class="card-badge"><%= jogo.genero.nome %></span><% } %>
                            <h3 class="card-title"><a href="/site/jogo-detalhes/<%= jogo.id %>"><%= jogo.titulo %></a></h3>
                            <p class="card-meta"><%= jogo.descricao %></p>
                            <p class="card-meta">Ano: <%= jogo.anoLancamento %> | Dificuldade: <%= jogo.dificuldade %></p>
                            <a href="/site/jogo-detalhes/<%= jogo.id %>" class="btn btn-outline">Ver detalhes</a>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <p class="card-meta">Nenhum jogo cadastrado.</p>
            <% } %>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 GamePortal - Sistema de Gestão de Jogos. Todos os direitos reservados.</p>
        <p><small>Desenvolvido para acessibilidade e navegação responsiva.</small></p>
    </footer>
    <script src="js/main.js"></script>
</body>
</html>
