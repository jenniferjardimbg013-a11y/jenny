<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamePortal - Gestão e Consulta de Jogos</title>
    <link rel="stylesheet" href="/css/site/style.css">
</head>
<body>
    <div class="accessibility-bar" role="region" aria-label="Acessibilidade">
        <span>Acessibilidade:</span>
        <button id="btn-increase-font" aria-label="Aumentar fonte">A+</button>
        <button id="btn-decrease-font" aria-label="Diminuir fonte">A-</button>
        <button id="btn-reset-font" aria-label="Tamanho normal">A</button>
    </div>

    <%- include('cabecalho.ejs') %>

    <main>
        <h2 class="section-title">Catálogo Completo de Jogos</h2>

        <div class="search-filter-bar">
            <input type="text" placeholder="Pesquisar por título..." aria-label="Pesquisar por título">
            <select aria-label="Filtrar por Gênero">
                <option value="">Todos os Gêneros</option>
                <option value="rpg">RPG</option>
                <option value="acao">Ação</option>
                <option value="aventura">Aventura</option>
            </select>
            <select aria-label="Filtrar por Plataforma">
                <option value="">Todas as Plataformas</option>
                <option value="pc">PC</option>
                <option value="ps5">PlayStation 5</option>
                <option value="switch">Nintendo Switch</option>
            </select>
            <button class="btn btn-primary">Buscar</button>
        </div>

        <div class="grid">
            <div class="card">
                <img src="https://via.placeholder.com/300x180/1e293b/06b6d4?text=The+Witcher+3" alt="Capa The Witcher 3" class="card-img">
                <div class="card-body">
                    <span class="card-badge">RPG</span>
                    <h3 class="card-title"><a href="/site/jogo-detalhes">The Witcher 3</a></h3>
                    <p class="card-meta">Ano: 2015 | Dificuldade: Média</p>
                    <a href="/site/jogo-detalhes" class="btn btn-outline" style="text-align:center;">Ver Detalhes</a>
                </div>
            </div>
            <div class="card">
                <img src="https://via.placeholder.com/300x180/1e293b/8b5cf6?text=Elden+Ring" alt="Capa Elden Ring" class="card-img">
                <div class="card-body">
                    <span class="card-badge">Ação / RPG</span>
                    <h3 class="card-title"><a href="/site/jogo-detalhes">Elden Ring</a></h3>
                    <p class="card-meta">Ano: 2022 | Dificuldade: Difícil</p>
                    <a href="/site/jogo-detalhes" class="btn btn-outline" style="text-align:center;">Ver Detalhes</a>
                </div>
            </div>
            <div class="card">
                <img src="https://via.placeholder.com/300x180/1e293b/06b6d4?text=Zelda+TOTK" alt="Capa Zelda TOTK" class="card-img">
                <div class="card-body">
                    <span class="card-badge">Aventura</span>
                    <h3 class="card-title"><a href="/site/jogo-detalhes">Tears of the Kingdom</a></h3>
                    <p class="card-meta">Ano: 2023 | Dificuldade: Média</p>
                    <a href="/site/jogo-detalhes" class="btn btn-outline" style="text-align:center;">Ver Detalhes</a>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 GamePortal - Sistema de Gestão de Jogos. Todos os direitos reservados.</p>
        <p><small>Desenvolvido para acessibilidade e navegação responsiva.</small></p>
    </footer>
    <script src="js/main.js"></script>
</body>
</html>
