<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamePortal - Gestão e Consulta de Jogos</title>
    <link rel="stylesheet" href="/css/site/style.css">
</head>

<body>
    <div class="accessibility-bar" role="region" aria-label="Acessibilidade">
        <span>Acessibilidade:</span>
        <button id="btn-increase-font" aria-label="Aumentar fonte">A+</button>
        <button id="btn-decrease-font" aria-label="Diminuir fonte">A-</button>
        <button id="btn-reset-font" aria-label="Tamanho normal">A</button>
    </div>

    <%- include('cabecalho.ejs') %>

        <main>
            <section class="hero">
                <h1>Descubra e Avalie seus Jogos Favoritos</h1>
                <p>Explore um vasto catálogo de jogos, desenvolvedoras, gêneros e plataformas. Faça parte da nossa
                    comunidade gamer!</p>
                <a href="/site/jogos" class="btn btn-primary">Explorar Jogos</a>
            </section>

            <section>
                <h2 class="section-title">Jogos em Destaque</h2>
                <div class="grid">
                    <% if (jogos.length) { %>
                        <% jogos.forEach((jogo)=> { %>
                            <article class="card">
                                <% if (jogo.capa) { %>
                                    <img src="/jogo/capa/<%= jogo._id %>" alt="Capa de <%= jogo.titulo %>"
                                        class="card-img">
                                    <% } else { %>
                                        <div class="card-img card-img-placeholder" role="img"
                                            aria-label="Capa não cadastrada">Capa não cadastrada</div>
                                        <% } %>
                                            <div class="card-body">
                                                <h3 class="card-title">
                                                    <%= jogo.titulo %>
                                                </h3>
                                                <p class="card-meta">
                                                    <%= jogo.descricao %>
                                                </p>
                                            </div>
                            </article>
                            <% }) %>
                                <% } else { %>
                                    <p class="card-meta">Nenhum jogo cadastrado para destacar.</p>
                                    <% } %>
                </div>
            </section>
        </main>

        <footer>
            <p>&copy; 2026 GamePortal - Sistema de Gestão de Jogos. Todos os direitos reservados.</p>
            <p><small>Desenvolvido para acessibilidade e navegação responsiva.</small></p>
        </footer>
        <script src="js/main.js"></script>
</body>

</html>