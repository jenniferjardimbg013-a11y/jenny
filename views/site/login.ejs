<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamePortal - Gestão e Consulta de Jogos</title>
    <link rel="stylesheet" href="/css/site/style.css">
</head>
<body>
    <div class="accessibility-bar" role="region" aria-label="Acessibilidade">
        <span>Acessibilidade:</span>
        <button id="btn-increase-font" aria-label="Aumentar fonte">A+</button>
        <button id="btn-decrease-font" aria-label="Diminuir fonte">A-</button>
        <button id="btn-reset-font" aria-label="Tamanho normal">A</button>
    </div>

    <%- include('cabecalho.ejs') %>

    <main>
        <div class="form-container">
            <h2 style="text-align: center; margin-bottom: 1.5rem;">Entrar na Conta</h2>
            <form>
                <div class="form-group">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" placeholder="seu@email.com" required>
                </div>
                <div class="form-group">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" placeholder="Sua senha" required>
                </div>
                <button type="button" class="btn btn-primary" style="width: 100%;">Entrar</button>
            </form>
            <p style="text-align: center; margin-top: 1rem; color: var(--text-muted);">
                Ainda não tem conta? <a href="/site/">Volte ao início</a>
            </p>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 GamePortal - Sistema de Gestão de Jogos. Todos os direitos reservados.</p>
        <p><small>Desenvolvido para acessibilidade e navegação responsiva.</small></p>
    </footer>
    <script src="js/main.js"></script>
</body>
</html>
