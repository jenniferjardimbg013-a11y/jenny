<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamePortal - Gestão e Consulta de Jogos</title>
    <link rel="stylesheet" href="/css/site/style.css">
</head>
<body>
    <div class="accessibility-bar" role="region" aria-label="Acessibilidade">
        <span>Acessibilidade:</span>
        <button id="btn-increase-font" aria-label="Aumentar fonte">A+</button>
        <button id="btn-decrease-font" aria-label="Diminuir fonte">A-</button>
        <button id="btn-reset-font" aria-label="Tamanho normal">A</button>
    </div>

    <%- include('cabecalho.ejs') %>

    <main>
        <a href="/site/jogos" class="btn btn-outline">Voltar aos jogos</a>
        <section class="details-header">
            <% if (jogo.capa && jogo.capa.length > 0) { %>
                <img src="/jogo/capa/<%= jogo.id %>" alt="Capa de <%= jogo.titulo %>" class="details-cover">
            <% } else { %>
                <div class="details-cover card-img-placeholder" role="img" aria-label="Capa não cadastrada">Capa não cadastrada</div>
            <% } %>
            <div class="details-info">
                <h1><%= jogo.titulo %></h1>
                <div class="details-tags">
                    <% if (jogo.genero) { %><span class="tag">Gênero: <%= jogo.genero.nome %></span><% } %>
                    <% if (jogo.plataforma) { %><span class="tag">Plataforma: <%= jogo.plataforma.nome %></span><% } %>
                    <span class="tag">Classificação: <%= jogo.classificacaoEtaria %></span>
                    <span class="tag">Dificuldade: <%= jogo.dificuldade %></span>
                </div>
                <% if (jogo.desenvolvedora) { %><p><strong>Desenvolvedora:</strong> <%= jogo.desenvolvedora.nome %></p><% } %>
                <p><strong>Ano de lançamento:</strong> <%= jogo.anoLancamento %></p>
                <p><%= jogo.descricao %></p>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 GamePortal - Sistema de Gestão de Jogos. Todos os direitos reservados.</p>
        <p><small>Desenvolvido para acessibilidade e navegação responsiva.</small></p>
    </footer>
    <script src="js/main.js"></script>
</body>
</html>
