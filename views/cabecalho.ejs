<!--Cabeçalho-->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestão de Jogos</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
    <header class="app-header">
        <div class="app-header-inner">
            <a class="app-brand" href="/site/">
                <i class="fa fa-gamepad" aria-hidden="true"></i>
                <span>Portal da Jenny</span>
            </a>
            <nav class="app-nav" aria-label="Navegação principal">
                <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
                <a href="/jogo/lst" class="<%= currentPath.startsWith('/jogo') ? 'active' : '' %>">Jogos</a>
                <a href="/desenvolvedora/lst" class="<%= currentPath.startsWith('/desenvolvedora') ? 'active' : '' %>">
                    Desenvolvedoras
                </a>
                <a href="/genero/lst" class="<%= currentPath.startsWith('/genero') ? 'active' : '' %>">Gêneros</a>
                <a href="/plataforma/lst"
                    class="<%= currentPath.startsWith('/plataforma') ? 'active' : '' %>">Plataformas</a>
                <a href="/usuario/lst" class="<%= currentPath.startsWith('/usuario') ? 'active' : '' %>">Usuários</a>
                <a href="/avaliacao/lst"
                    class="<%= currentPath.startsWith('/avaliacao') ? 'active' : '' %>">Avaliações</a>
            </nav>
        </div>
    </header>
    <div class="container">
        <!--Cabeçalho - Fim-->