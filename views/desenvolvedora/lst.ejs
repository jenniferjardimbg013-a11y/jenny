<%-include('../cabecalho.ejs')%>

    <main class="list-page">
        <h1>Desenvolvedoras</h1>

        <div class="list-toolbar">
            <form class="list-search" action="" method="post">
                <input type="text" name="filtro" placeholder="Digite o nome da desenvolvedora">
                <button class="button" type="submit">Pesquisar</button>
            </form>
            <a class="button" href="/desenvolvedora/add">+ Nova desenvolvedora</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">País</th>
                        <th scope="col">Ano de fundação</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <%for (const {id, nome, pais, anoFundacao} of Desenvolvedoras) {%>
                        <tr>
                            <td>
                                <%=nome%>
                            </td>
                            <td>
                                <%=pais%>
                            </td>
                            <td>
                                <%=anoFundacao%>
                            </td>
                            <td class="table-actions">
                                <a class="button button-small secondary" href="/desenvolvedora/edt/<%=id%>">Editar</a>
                                <a class="button button-small button-danger"
                                    href="/desenvolvedora/del/<%=id%>">Excluir</a>
                            </td>
                        </tr>
                        <%}%>
                </tbody>
            </table>
        </div>
    </main>

    <%-include('../rodape.ejs')%>