<%-include('../cabecalho.ejs')%>

<h1>Desenvolvedoras</h1>

<div>
    <form action="" method="post">
        <input type="text" name="filtro" placeholder="digite o nome da desenvolvedora">
        <button type="submit">Pesquisar</button>
    </form>
</div>

<a href="/desenvolvedora/add">+ Desenvolvedora</a>

<table>

    <tr>
        <td>Nome</td>
        <td>País</td>
        <td>Ano Fundação</td>
        <td>Ações</td>
    </tr>

    <%for (const {id, nome, pais, anoFundacao} of Desenvolvedoras) {%>

    <tr>
        <td><%=nome%></td>
        <td><%=pais%></td>
        <td><%=anoFundacao%></td>

        <td>
            <a href="/desenvolvedora/edt/<%=id%>">Editar</a>
            <a href="/desenvolvedora/del/<%=id%>">Excluir</a>
        </td>
    </tr>

    <%}%>

</table>

<%-include('../rodape.ejs')%>