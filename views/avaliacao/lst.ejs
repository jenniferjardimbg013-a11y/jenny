<%-include('../cabecalho.ejs')%>

    <h1>Avaliações</h1>

    <div>
        <form action="" method="post">
            <input type="text" name="filtro" placeholder="digite o comentário">
            <button type="submit">Pesquisar</button>
        </form>
    </div>

    <a href="/avaliacao/add">+ Avaliação</a>

    <table>

        <tr>
            <td>Usuário</td>
            <td>Jogo</td>
            <td>Nota</td>
            <td>Comentário</td>
            <td>Data</td>
            <td>Ações</td>
        </tr>

        <%for (const avaliacao of Avaliacoes) {%>

            <tr>
                <td><%=avaliacao.usuario ? avaliacao.usuario.nome : ''%></td>
                <td>
                    <%=avaliacao.jogo ? avaliacao.jogo.titulo : '' %>
                </td>
                <td>
                    <%=avaliacao.nota%>
                </td>
                <td>
                    <%=avaliacao.comentario%>
                </td>
                <td>
                    <%=avaliacao.data%>
                </td>

                <td>
                    <a href="/avaliacao/edt/<%=avaliacao.id%>">Editar</a>
                    <a href="/avaliacao/del/<%=avaliacao.id%>">Excluir</a>
                </td>
            </tr>

            <%}%>

    </table>

    <%-include('../rodape.ejs')%>