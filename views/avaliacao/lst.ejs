<%-include('../cabecalho.ejs')%>

<h1>Avaliações</h1>

<a href="/avaliacao/add">+ Avaliação</a>

<table>

    <tr>
        <td>Usuário</td>
        <td>Jogo</td>
        <td>Nota</td>
        <td>Comentário</td>
        <td>Data</td>
        <td>Ações</td>
    </tr>

    <%for (const {id, usuario, jogo, nota, comentario, data} of Avaliacoes) {%>

    <tr>
        <td><%=usuario%></td>
        <td><%=jogo%></td>
        <td><%=nota%></td>
        <td><%=comentario%></td>
        <td><%=data%></td>

        <td>
            <a href="/avaliacao/edt/<%=id%>">Editar</a>
            <a href="/avaliacao/del/<%=id%>">Excluir</a>
        </td>
    </tr>

    <%}%>

</table>

<%-include('../rodape.ejs')%>