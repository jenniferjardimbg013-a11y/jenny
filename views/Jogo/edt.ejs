<%-include('../cabecalho.ejs')%>

<h1>Editar Jogo</h1>

<div>
    <a href="/jogo/lst">Listar</a>
</div>

<div>

    <form method="post" enctype="multipart/form-data">

        <input type="hidden" name="id" 
        value="<%=Jogo.id%>"><br>

        <label>Título:</label>
        <input type="text" name="titulo" 
        value="<%=Jogo.titulo%>"><br>

        <label>Descrição:</label>
        <input type="text" name="descricao"
        value="<%=Jogo.descricao%>"><br>

        <label>Ano de Lançamento:</label>
        <input type="number" name="anoLancamento"
        value="<%=Jogo.anoLancamento%>"><br>

        <label>Classificação Etária:</label>
        <input type="text" name="classificacaoEtaria"
        value="<%=Jogo.classificacaoEtaria%>"><br>

        <label>Dificuldade:</label>
        <input type="text" name="dificuldade"
        value="<%=Jogo.dificuldade%>"><br>

        <label>Capa:</label>
        <input type="file" name="capa" accept="image/*"><br>
        <% if (Jogo.capa) { %>
            <img src="/jogo/capa/<%=Jogo.id%>" alt="Capa de <%=Jogo.titulo%>" width="120">
            <label><input type="checkbox" name="removerCapa"> Remover capa atual</label><br>
        <% } %>

        <label>Desenvolvedora:</label>
        <input type="text" name="desenvolvedora"
        value="<%=Jogo.desenvolvedora%>"><br>

        <label>Gênero:</label>
        <input type="text" name="genero"
        value="<%=Jogo.genero%>"><br>

        <label>Plataforma:</label>
        <input type="text" name="plataforma"
        value="<%=Jogo.plataforma%>"><br>

        <button type="submit">Editar</button>

    </form>

</div>

<%-include('../rodape.ejs')%>