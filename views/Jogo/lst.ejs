<%-include('../cabecalho.ejs')%>

<h1>Jogos</h1>

<div>
    <form action="" method="post">
        <input type="text" name="filtro"
        id="" placeholder="digite o nome do jogo">
        <button type="submit">Pesquisar</button>
    </form>
</div>

<a href="/jogo/add">+ Jogo</a>

<table>
    <tr>
        <td>Capa</td>
        <td>Título</td>
        <td>Ano de Lançamento</td>
        <td>Dificuldade</td>
        <td>Classificação Etária</td>
        <td>Desenvolvedora</td>
        <td>Gênero</td>
        <td>Plataforma</td>
        <td>Ações</td>
    </tr>

    <%for (const jogo of Jogos) {%>

    <tr>
        <td><% if (jogo.capa) { %><img src="/jogo/capa/<%=jogo.id%>" alt="Capa de <%=jogo.titulo%>" width="60"><% } %></td>
        <td><%=jogo.titulo%></td>
        <td><%=jogo.anoLancamento%></td>
        <td><%=jogo.dificuldade%></td>
        <td><%=jogo.classificacaoEtaria%></td>
        <td><%=jogo.desenvolvedora ? jogo.desenvolvedora.nome : ''%></td>
        <td><%=jogo.genero ? jogo.genero.nome : ''%></td>
        <td><%=jogo.plataforma ? jogo.plataforma.nome : ''%></td>

        <td>
            <a href="/jogo/edt/<%=jogo.id%>">Editar</a>
            <a href="/jogo/del/<%=jogo.id%>">Excluir</a>
        </td>
    </tr>

    <%}%>

</table>

<%-include('../rodape.ejs')%>