<%-include('../cabecalho.ejs')%>

    <main class="list-page">
        <h1>Jogos</h1>

        <div class="list-toolbar">
            <form class="list-search" action="" method="post">
                <input type="text" name="filtro" placeholder="Digite o nome do jogo">
                <button class="button" type="submit">Pesquisar</button>
            </form>
            <a class="button" href="/jogo/add">+ Novo jogo</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Capa</th>
                        <th scope="col">Título</th>
                        <th scope="col">Ano de lançamento</th>
                        <th scope="col">Dificuldade</th>
                        <th scope="col">Classificação etária</th>
                        <th scope="col">Desenvolvedora</th>
                        <th scope="col">Gênero</th>
                        <th scope="col">Plataforma</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <%for (const jogo of Jogos) {%>
                        <tr>
                            <td>
                                <% if (jogo.capa) { %><img src="/jogo/capa/<%=jogo.id%>" alt="Capa de <%=jogo.titulo%>"
                                        width="60">
                                    <% } %>
                            </td>
                            <td>
                                <%=jogo.titulo%>
                            </td>
                            <td>
                                <%=jogo.anoLancamento%>
                            </td>
                            <td>
                                <%=jogo.dificuldade%>
                            </td>
                            <td>
                                <%=jogo.classificacaoEtaria%>
                            </td>
                            <td>
                                <%=jogo.desenvolvedora ? jogo.desenvolvedora.nome : '' %>
                            </td>
                            <td>
                                <%=jogo.genero ? jogo.genero.nome : '' %>
                            </td>
                            <td>
                                <%=jogo.plataforma ? jogo.plataforma.nome : '' %>
                            </td>
                            <td class="table-actions">
                                <a class="button button-small secondary" href="/jogo/edt/<%=jogo.id%>">Editar</a>
                                <a class="button button-small button-danger" href="/jogo/del/<%=jogo.id%>">Excluir</a>
                            </td>
                        </tr>
                        <%}%>
                </tbody>
            </table>
        </div>
    </main>

    <%-include('../rodape.ejs')%>